package rules.coupon

import com.drools.promote.model.CouponRuleResult;

rule "优惠券满足500减50"
salience 50
    when
        $c:CouponRuleResult($ms:moneySum>500);
    then
        modify($c){
            setFinallyMoney($ms-50)
        }
        drools.halt();
end

